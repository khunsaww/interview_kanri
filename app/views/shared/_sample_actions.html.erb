<% if current_user.job_applications.samples.exists? %>
  <%= button_to "サンプルデータを削除", sample_data_path, method: :delete, class: "button button-secondary", data: { turbo_confirm: "【サンプル】の応募と、それに紐づく面接・準備タスクを削除します。自分で作成した記録は残ります。よろしいですか？" } %>
<% else %>
  <%= button_to "サンプルデータを読み込む", sample_data_path, method: :post, class: "button button-secondary" %>
<% end %>
