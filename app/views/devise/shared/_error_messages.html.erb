<% if resource.errors.any? %>
  <div class="form-errors" role="alert" id="error_explanation" tabindex="-1">
    <h2><%= resource.errors.count %>件の入力を確認してください</h2>
    <ul>
      <% resource.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
