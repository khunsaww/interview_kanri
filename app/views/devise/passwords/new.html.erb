<% content_for :title, "パスワード再設定" %>
<section class="auth-card">
  <h1>パスワード再設定</h1>
  <p>登録したメールアドレスに再設定用のリンクを送ります。</p>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "form" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <div class="field">
      <%= f.label :email, "メールアドレス（必須）" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true %>
    </div>
    <%= f.submit "再設定メールを送る", class: "button" %>
  <% end %>
  <%= render "devise/shared/links" %>
</section>
