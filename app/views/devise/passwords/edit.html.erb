<% content_for :title, "新しいパスワード" %>
<section class="auth-card">
  <h1>新しいパスワード</h1>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "form" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= f.hidden_field :reset_password_token %>
    <div class="field">
      <%= f.label :password, "新しいパスワード（必須）" %>
      <%= f.password_field :password, autofocus: true, autocomplete: "new-password", required: true, aria: { describedby: "reset-password-hint" } %>
      <p class="hint" id="reset-password-hint">8文字以上にしてください。</p>
    </div>
    <div class="field">
      <%= f.label :password_confirmation, "新しいパスワード（確認・必須）" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true %>
    </div>
    <%= f.submit "パスワードを変更する", class: "button" %>
  <% end %>
  <%= render "devise/shared/links" %>
</section>
