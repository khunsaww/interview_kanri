<% content_for :title, "アカウント" %>
<section class="auth-card">
  <h1>アカウント</h1>
  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "form" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <div class="field">
      <%= f.label :name, "名前（必須）" %>
      <%= f.text_field :name, autocomplete: "name", required: true, maxlength: 40 %>
    </div>
    <div class="field">
      <%= f.label :email, "メールアドレス（必須）" %>
      <%= f.email_field :email, autocomplete: "email", required: true %>
    </div>
    <div class="field">
      <%= f.label :password, "新しいパスワード" %>
      <%= f.password_field :password, autocomplete: "new-password", aria: { describedby: "account-password-hint" } %>
      <p class="hint" id="account-password-hint">変更しない場合は空欄のままにしてください。変えるときは8文字以上です。</p>
    </div>
    <div class="field">
      <%= f.label :password_confirmation, "新しいパスワード（確認）" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
    </div>
    <div class="field">
      <%= f.label :current_password, "現在のパスワード（必須）" %>
      <%= f.password_field :current_password, autocomplete: "current-password", required: true, aria: { describedby: "current-password-hint" } %>
      <p class="hint" id="current-password-hint">変更を保存するには、いまのパスワードが必要です。</p>
    </div>
    <%= f.submit "保存する", class: "button" %>
  <% end %>
  <p><%= link_to "ダッシュボードへ戻る", root_path %></p>
</section>
