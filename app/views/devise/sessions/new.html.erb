<% content_for :title, "ログイン" %>
<section class="auth-card">
  <h1>ログイン</h1>
  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "form" }) do |f| %>
    <div class="field">
      <%= f.label :email, "メールアドレス（必須）" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true %>
    </div>
    <div class="field">
      <%= f.label :password, "パスワード（必須）" %>
      <%= f.password_field :password, autocomplete: "current-password", required: true %>
    </div>
    <% if devise_mapping.rememberable? %>
      <div class="field checkbox">
        <%= f.check_box :remember_me %>
        <%= f.label :remember_me, "ログイン状態を保つ" %>
      </div>
    <% end %>
    <%= f.submit "ログイン", class: "button" %>
  <% end %>
  <%= render "devise/shared/links" %>
</section>
